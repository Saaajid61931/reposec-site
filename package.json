{
  "name": "reposec",
  "version": "0.1.0",
  "private": true,
  "description": "Launch-readiness security checks for AI-built applications.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "clean": "node scripts/clean.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "worker:dev": "npm run dev --workspace @reposec/scanner-worker",
    "worker:typecheck": "npm run typecheck --workspace @reposec/scanner-worker",
    "worker:build": "npm run build --workspace @reposec/scanner-worker",
    "preflight": "node scripts/preflight.mjs",
    "check": "npm run preflight && npm run typecheck && npm run lint && npm run build && npm run worker:typecheck && npm run worker:build"
  },
  "dependencies": {
    "@sentry/nextjs": "10.68.0",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.111.0",
    "lucide-react": "1.27.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "6.18.1",
    "stripe": "22.3.2",
    "zod": "4.4.3",
    "svix": "1.99.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.0.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.0.0",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.2"
  },
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "worker"
  ]
}
