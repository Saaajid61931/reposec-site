# Public application
NEXT_PUBLIC_APP_URL=https://reposec.site
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Supabase server-only
SUPABASE_SERVICE_ROLE_KEY=replace_me

# Scanner worker uses the same Supabase project URL.
SUPABASE_URL=https://your-project.supabase.co

# Encrypt server-side configuration with 32 random bytes encoded as base64.
CONFIG_ENCRYPTION_KEY=replace_with_base64_32_byte_key

# GitHub App (read-only Contents, Metadata, Actions, Administration)
GITHUB_APP_ID=replace_me
GITHUB_APP_SLUG=reposec
GITHUB_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_me\n-----END PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=replace_me
GITHUB_SETUP_URL=https://reposec.site/github/setup

# Stripe
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_LAUNCH_PACK_PRICE_ID=price_replace_me
STRIPE_MONITORING_PRICE_ID=price_replace_me
STRIPE_AGENCY_PRICE_ID=price_replace_me

# Transactional email
RESEND_API_KEY=re_replace_me
RESEND_WEBHOOK_SECRET=whsec_replace_me
EMAIL_FROM=RepoSec <reports@reposec.site>
SUPPORT_EMAIL=hello@reposec.site

# Worker-to-database and scheduling
WORKER_SHARED_SECRET=replace_with_at_least_32_random_characters
WEB_APP_URL=https://reposec.site
WORKER_ID=
WORKER_POLL_INTERVAL_MS=5000
WORKER_CONCURRENCY=2
SCAN_TIMEOUT_MS=600000
COMPONENT_TIMEOUT_MS=180000
PUBLIC_REPO_COMPRESSED_BYTES=15000000
FULL_REPO_COMPRESSED_BYTES=50000000
REPO_EXPANDED_BYTES=250000000
REPO_FILE_COUNT=25000
REPO_FILE_BYTES=2000000
SCANNER_RESULT_BYTES=20000000
CRON_SECRET=replace_with_at_least_32_random_characters

# Optional error reporting
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Optional admin bootstrap; app access still requires an admin membership row.
ADMIN_EMAILS=
